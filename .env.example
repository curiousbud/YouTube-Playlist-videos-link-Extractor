# Environment Variables for YouTube Playlist Video Extractor (MERN Stack)
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# MongoDB Connection (Optional - used for storing link history)
# If not set, the app will work without database persistence
MONGODB_URI=mongodb://localhost:27017/youtube-playlist-extractor

# YouTube Data API v3 Key (Required for playlist extraction)
# Get your API key from: https://console.developers.google.com/
# Enable YouTube Data API v3 for your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Password Protection
# In local development, leaving SITE_PASSWORD empty keeps the site public.
# In production, the app is locked to /login until SITE_PASSWORD is configured
# (fail-closed). Set it before the first production deploy.
SITE_PASSWORD=change_me_to_a_strong_password

# Session cookie signing secret (Optional)
# A random string used to sign the login session cookie. Generate one with:
#   openssl rand -base64 32
# If unset, a key is derived from SITE_PASSWORD instead.
SESSION_SECRET=
