# Environment Variables for YouTube Playlist Video Extractor (MERN Stack)
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# MongoDB Connection (Optional - used for storing link history)
# If not set, the app will work without database persistence
MONGODB_URI=mongodb://localhost:27017/youtube-playlist-extractor

# YouTube Data API v3 Key (Required for playlist extraction)
# Get your API key from: https://console.developers.google.com/
# Enable YouTube Data API v3 for your project
YOUTUBE_API_KEY=your_youtube_api_key_here

# Redis URL (Optional - for enhanced caching)
# If not set, the app uses in-memory caching
REDIS_URL=redis://localhost:6379

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
