# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

/.yt-dlp

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Old Django/Python files (file patterns only — directory rules like `lib/`,
# `bin/`, `include/`, `share/` were removed because they collide with this
# project's TypeScript source directories)
*.pyc
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/
.venv
venv/
ENV/
env/
pyvenv.cfg

# Development documentation (keep local only)
DEPLOYMENT_STATUS.md
SECURITY_SETUP.md
DEPLOYMENT_CHECKLIST.md
UPGRADE_SUMMARY.md
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Cache
.cache/

# ytdl-core runtime cache (player scripts written to the working directory)
*-player-script.js

# Testing
.coverage
.pytest_cache/
htmlcov/

# Backup files
*.bak
*.backup

# Temporary files
*.tmp
*.temp
